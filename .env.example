# ---------------------------------------------------------------------------
# LE Fleuriste — variables d'environnement
# Copiez ce fichier en .env.local (jamais commité) et complétez les valeurs.
# ---------------------------------------------------------------------------

# Conseiller floral (feature 2). Sans cette clé, le widget de conversation
# fonctionne toujours : il répond par le message de repli et les bouquets les
# plus demandés, sans jamais planter.
#
# Obtenir une clé :
#   1. Créez un compte sur https://console.mistral.ai
#   2. Ouvrez « API Keys », puis « Create new key »
#   3. Copiez la clé ici. Elle reste côté serveur : elle n'est lue que par
#      app/api/chat/route.ts et n'apparaît jamais dans le bundle navigateur.
MISTRAL_API_KEY=

# Modèle utilisé par le conseiller. Laissez vide pour le modèle par défaut
# (mistral-medium-3-5-26-04), bon compromis qualité/coût pour de l'agentique.
MISTRAL_MODEL=

# URL publique du site, utilisée par le sitemap, les métadonnées Open Graph
# et le JSON-LD LocalBusiness. En développement, laissez vide.
NEXT_PUBLIC_SITE_URL=
